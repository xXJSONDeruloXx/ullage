#!/bin/sh
# Default pre/post lifecycle adapter for ullage-bridge.
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)

[ -n "${ULLAGE_STEAM_ACCESS_TOKEN:-}" ] || {
    printf '%s\n' 'ullage-cloud-hook: ULLAGE_STEAM_ACCESS_TOKEN is required' >&2
    exit 2
}
[ -n "${ULLAGE_STEAM3_ACCOUNT_ID:-}" ] || {
    printf '%s\n' 'ullage-cloud-hook: ULLAGE_STEAM3_ACCOUNT_ID is required' >&2
    exit 2
}
[ -n "${ULLAGE_WINE_USER:-}" ] || {
    printf '%s\n' 'ullage-cloud-hook: ULLAGE_WINE_USER is required' >&2
    exit 2
}

set -- \
    --appid "$ULLAGE_APPID" \
    --appinfo "$ULLAGE_APPINFO" \
    --prefix "$ULLAGE_PREFIX" \
    --user "$ULLAGE_WINE_USER" \
    --steam3-account-id "$ULLAGE_STEAM3_ACCOUNT_ID"

if [ -n "${ULLAGE_STEAMID64:-}" ]; then
    set -- "$@" --steamid64 "$ULLAGE_STEAMID64"
fi

case "$ULLAGE_CLOUD_PHASE" in
    pre) set -- "$@" --download ;;
    post) set -- "$@" --upload ;;
    *) printf 'ullage-cloud-hook: unknown phase: %s\n' "$ULLAGE_CLOUD_PHASE" >&2; exit 2 ;;
esac

exec "$SCRIPT_DIR/ullage-cloud-sync.py" "$@"

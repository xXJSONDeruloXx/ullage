#!/bin/sh
# Launch a Windows Steam depot through a macOS Wine/Game Porting Toolkit
# runtime while keeping the native macOS Steam client as the Steam backend.
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
BRIDGE_HOME=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)
HOME_VALUE=${HOME:-/tmp}

die() {
    printf 'ullage-bridge: %s\n' "$*" >&2
    exit 2
}

usage() {
    cat >&2 <<'EOF'
Usage:
  ullage-bridge --config FILE [options] [-- game-arguments...]

Required options (normally supplied by FILE):
  --appid ID                 Steam AppID
  --game-exe PATH            genuine Windows executable, not the shim

Runtime options:
  --game-dir PATH             working directory (defaults to executable dir)
  --prefix PATH               Wine prefix
  --arch auto|win32|win64     PE architecture (default: auto)
  --steam-root PATH           native Steam library root
  --wine-root PATH             GameHub Wine installation root
  --gptk-root PATH            Game Porting Toolkit runtime root
  --bridge-root PATH          directory containing lsteamclient artifacts
  --fd-exec PATH              fd-cleaning exec helper
  --reaper PATH               prefix-scoped Wine helper reaper
  --log PATH                  append Wine output here
  --wine-debug VALUE          WINEDEBUG value (default: -all)
  --winemsync VALUE           WINEMSYNC value (default: 1)
  --legacy-steam              require staged 32-bit legacy Steam DLLs
  --preserve-steam-transport  retain Steam's launch dylibs and IPC descriptors (default)
  --clean-steam-transport     close inherited Steam descriptors and skip overlay injection
  --cloud-sync-command CMD     optional pre/post launch Cloud adapter command
  --cloud-cdp                  use native Steam CEF session for Cloud reads
  --dry-run                   validate and print the resolved launch
  --help

The -- separator is required before arguments intended for the game.
EOF
}

CONFIG=
APP_ID=
GAME_EXE=
GAME_DIR=
PREFIX=
ARCH=auto
STEAM_ROOT="${STEAM_ROOT:-$HOME_VALUE/Library/Application Support/Steam}"
WINE_ROOT="${WINE_ROOT:-}"
GPTK_ROOT="${GPTK_ROOT:-}"
BRIDGE_ROOT="${BRIDGE_ROOT:-$BRIDGE_HOME/runtime/lsteamclient}"
FD_EXEC="${FD_EXEC:-$SCRIPT_DIR/ullage-fd-exec}"
REAPER="${REAPER:-$SCRIPT_DIR/ullage-reap}"
LOG_FILE=
LEGACY_STEAM=0
DRY_RUN=0
WINE_DEBUG_VALUE=${WINE_DEBUG_VALUE:--all}
WINEMSYNC_VALUE=${WINEMSYNC_VALUE:-1}
PRESERVE_STEAM_TRANSPORT=1
CLOUD_SYNC_COMMAND=${CLOUD_SYNC_COMMAND:-}
CLOUD_CDP=${CLOUD_CDP:-0}
CLOUD_STEAM3_ACCOUNT_ID=${CLOUD_STEAM3_ACCOUNT_ID:-}
CLOUD_STEAMID64=${CLOUD_STEAMID64:-}
CLOUD_WINE_USER=${CLOUD_WINE_USER:-${USER:-}}

load_config() {
    config_path=$1
    [ -r "$config_path" ] || die "config is not readable: $config_path"
    # Config files are generated by ullage-install and contain only
    # shell assignments. They are intentionally user-owned generated state.
    # shellcheck disable=SC1090
    . "$config_path"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --config)
            [ "$#" -ge 2 ] || die "--config requires a path"
            CONFIG=$2
            load_config "$CONFIG"
            shift 2
            ;;
        --appid)
            [ "$#" -ge 2 ] || die "--appid requires a value"
            APP_ID=$2
            shift 2
            ;;
        --game-exe)
            [ "$#" -ge 2 ] || die "--game-exe requires a path"
            GAME_EXE=$2
            shift 2
            ;;
        --game-dir)
            [ "$#" -ge 2 ] || die "--game-dir requires a path"
            GAME_DIR=$2
            shift 2
            ;;
        --prefix)
            [ "$#" -ge 2 ] || die "--prefix requires a path"
            PREFIX=$2
            shift 2
            ;;
        --arch)
            [ "$#" -ge 2 ] || die "--arch requires a value"
            ARCH=$2
            shift 2
            ;;
        --steam-root)
            [ "$#" -ge 2 ] || die "--steam-root requires a path"
            STEAM_ROOT=$2
            shift 2
            ;;
        --wine-root)
            [ "$#" -ge 2 ] || die "--wine-root requires a path"
            WINE_ROOT=$2
            shift 2
            ;;
        --gptk-root)
            [ "$#" -ge 2 ] || die "--gptk-root requires a path"
            GPTK_ROOT=$2
            shift 2
            ;;
        --bridge-root)
            [ "$#" -ge 2 ] || die "--bridge-root requires a path"
            BRIDGE_ROOT=$2
            shift 2
            ;;
        --fd-exec)
            [ "$#" -ge 2 ] || die "--fd-exec requires a path"
            FD_EXEC=$2
            shift 2
            ;;
        --reaper)
            [ "$#" -ge 2 ] || die "--reaper requires a path"
            REAPER=$2
            shift 2
            ;;
        --log)
            [ "$#" -ge 2 ] || die "--log requires a path"
            LOG_FILE=$2
            shift 2
            ;;
        --wine-debug)
            [ "$#" -ge 2 ] || die "--wine-debug requires a value"
            WINE_DEBUG_VALUE=$2
            shift 2
            ;;
        --winemsync)
            [ "$#" -ge 2 ] || die "--winemsync requires a value"
            WINEMSYNC_VALUE=$2
            shift 2
            ;;
        --legacy-steam)
            LEGACY_STEAM=1
            shift
            ;;
        --preserve-steam-transport)
            PRESERVE_STEAM_TRANSPORT=1
            shift
            ;;
        --clean-steam-transport)
            PRESERVE_STEAM_TRANSPORT=0
            shift
            ;;
        --cloud-sync-command)
            [ "$#" -ge 2 ] || die "--cloud-sync-command requires a value"
            CLOUD_SYNC_COMMAND=$2
            shift 2
            ;;
        --cloud-cdp)
            CLOUD_CDP=1
            shift
            ;;
        --cloud-steam3-account-id)
            [ "$#" -ge 2 ] || die "--cloud-steam3-account-id requires a value"
            CLOUD_STEAM3_ACCOUNT_ID=$2
            shift 2
            ;;
        --cloud-wine-user)
            [ "$#" -ge 2 ] || die "--cloud-wine-user requires a value"
            CLOUD_WINE_USER=$2
            shift 2
            ;;
        --cloud-steamid64)
            [ "$#" -ge 2 ] || die "--cloud-steamid64 requires a value"
            CLOUD_STEAMID64=$2
            shift 2
            ;;
        --no-legacy-steam)
            LEGACY_STEAM=0
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            die "unknown option: $1 (put game arguments after --)"
            ;;
    esac
done

[ -n "$APP_ID" ] || die "missing --appid"
[ -n "$GAME_EXE" ] || die "missing --game-exe"
[ -n "$WINE_ROOT" ] || die "set --wine-root or WINE_ROOT"
[ -n "$GPTK_ROOT" ] || die "set --gptk-root or GPTK_ROOT"
case "$APP_ID" in
    *[!0-9]*|'' ) die "AppID must be numeric: $APP_ID" ;;
esac

case "$GAME_EXE" in
    /*) ;;
    *) GAME_EXE=$(CDPATH= cd "$(dirname "$GAME_EXE")" && pwd)/$(basename "$GAME_EXE") ;;
esac
[ -f "$GAME_EXE" ] || die "game executable is not a regular file: $GAME_EXE"
[ ! -L "$GAME_EXE" ] || die "game executable must not be a symlink: $GAME_EXE"

if [ -z "$GAME_DIR" ]; then
    GAME_DIR=$(CDPATH= cd "$(dirname "$GAME_EXE")" && pwd)
else
    case "$GAME_DIR" in
        /*) ;;
        *) GAME_DIR=$(CDPATH= cd "$GAME_DIR" && pwd) ;;
    esac
fi
[ -d "$GAME_DIR" ] || die "game directory does not exist: $GAME_DIR"

if [ -z "$PREFIX" ]; then
    PREFIX="${WINEPREFIX:-$BRIDGE_HOME/compatdata/$APP_ID/pfx}"
fi
if [ -z "$LOG_FILE" ]; then
    LOG_FILE="$BRIDGE_HOME/logs/$APP_ID.log"
fi

FILE_CMD=/usr/bin/file
[ -x "$FILE_CMD" ] || die "missing /usr/bin/file"
GAME_FILE_INFO=$($FILE_CMD -b "$GAME_EXE")
case "$ARCH" in
    auto)
        case "$GAME_FILE_INFO" in
            *'PE32+'*) ARCH=win64 ;;
            *'PE32 executable'*) ARCH=win32 ;;
            *) die "could not identify a Windows PE executable: $GAME_FILE_INFO" ;;
        esac
        ;;
    win32|win64) ;;
    *) die "invalid --arch: $ARCH" ;;
esac

case "$ARCH:$GAME_FILE_INFO" in
    win64:*'PE32+'*) ;;
    win32:*'PE32 executable'*) ;;
    *) die "--arch=$ARCH does not match: $GAME_FILE_INFO" ;;
esac

case "$PRESERVE_STEAM_TRANSPORT" in
    0|1) ;;
    *) die "invalid --preserve-steam-transport value: $PRESERVE_STEAM_TRANSPORT" ;;
esac

WINE_BIN="$WINE_ROOT/bin/wine"
WINESERVER="$WINE_ROOT/bin/wineserver"
STEAM_CLIENT_DYLIB="$STEAM_ROOT/Steam.AppBundle/Steam/Contents/MacOS/steamclient.dylib"
GPTK_D3DSHARED="$GPTK_ROOT/external/libd3dshared.dylib"
HOST_LSTEAMCLIENT="$BRIDGE_ROOT/x86_64-unix/lsteamclient.so"
if [ "$ARCH" = win64 ]; then
    WIN_LSTEAMCLIENT="$BRIDGE_ROOT/x86_64-windows/lsteamclient.dll"
else
    WIN_LSTEAMCLIENT="$BRIDGE_ROOT/i386-windows/lsteamclient.dll"
fi

require_file() {
    [ -f "$1" ] || die "required file is missing: $1"
}

require_exec() {
    [ -x "$1" ] || die "required executable is missing or not executable: $1"
}

require_exec "$FD_EXEC"
require_exec "$REAPER"
require_exec "$WINE_BIN"
require_exec "$WINESERVER"
require_file "$STEAM_CLIENT_DYLIB"
require_file "$GPTK_D3DSHARED"
require_file "$HOST_LSTEAMCLIENT"
require_file "$WIN_LSTEAMCLIENT"
require_file "$PREFIX/system.reg"
if [ "$LEGACY_STEAM" = 1 ]; then
    LEGACY_STEAM_DIR="$PREFIX/drive_c/Program Files (x86)/Steam"
    for legacy_file in steam.dll steamclient.dll tier0_s.dll vstdlib_s.dll; do
        require_file "$LEGACY_STEAM_DIR/$legacy_file"
    done
fi

if [ "$DRY_RUN" = 1 ]; then
    printf 'appid=%s\n' "$APP_ID"
    printf 'arch=%s\n' "$ARCH"
    printf 'game_exe=%s\n' "$GAME_EXE"
    printf 'game_dir=%s\n' "$GAME_DIR"
    printf 'prefix=%s\n' "$PREFIX"
    printf 'wine=%s\n' "$WINE_BIN"
    printf 'gptk=%s\n' "$GPTK_ROOT"
    printf 'steam_client=%s\n' "$STEAM_CLIENT_DYLIB"
    printf 'host_lsteamclient=%s\n' "$HOST_LSTEAMCLIENT"
    printf 'win_lsteamclient=%s\n' "$WIN_LSTEAMCLIENT"
    printf 'reaper=%s\n' "$REAPER"
    printf 'legacy_steam=%s\n' "$LEGACY_STEAM"
    printf 'preserve_steam_transport=%s\n' "$PRESERVE_STEAM_TRANSPORT"
    printf 'game_argument_count=%s\n' "$#"
    exit 0
fi

mkdir -p "$(dirname "$LOG_FILE")"
USER_VALUE=${USER:-$(id -un)}
LOGNAME_VALUE=${LOGNAME:-$USER_VALUE}
LANG_VALUE=${LANG:-en_US.UTF-8}
PATH_VALUE=/usr/bin:/bin:/usr/sbin:/sbin
WINEDLLPATH_VALUE=${WINEDLLPATH_VALUE:-$BRIDGE_ROOT:$GPTK_ROOT/wine:$WINE_ROOT/lib/wine}
DYLD_FALLBACK_LIBRARY_PATH_VALUE=${DYLD_FALLBACK_LIBRARY_PATH_VALUE:-$GPTK_ROOT/external:$WINE_ROOT/lib:$WINE_ROOT/lib/wine/x86_64-unix}
WINEDLLOVERRIDES_VALUE=${WINEDLLOVERRIDES_VALUE:-lsteamclient=b}
STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT/Steam.AppBundle/Steam/Contents/MacOS"

# Native Steam uses these values to bootstrap its macOS loader/overlay and
# Steam IPC transport. They are captured before the clean environment is
# constructed and reintroduced by the default transport-preserving launch.
STEAM_DYLD_INSERT_LIBRARIES_VALUE=${STEAM_DYLD_INSERT_LIBRARIES:-}
STEAM_ENV_VALUE=${SteamEnv:-}
STEAM_APP_USER_VALUE=${SteamAppUser:-}
STEAM_USER_VALUE=${SteamUser:-}
STEAM3_MASTER_VALUE=${Steam3Master:-}
STEAM_VIRTUAL_GAMEPAD_INFO_VALUE=${SteamVirtualGamepadInfo:-}
STEAM_CLIENT_CONFIG_FILE_VALUE=${STEAM_CLIENT_CONFIG_FILE:-}
STEAM_APP_BUNDLE_PATH_VALUE=${STEAM_APP_BUNDLE_PATH:-}
ENABLE_VK_LAYER_STEAM_OVERLAY_VALUE=${ENABLE_VK_LAYER_VALVE_steam_overlay_1:-}
SDL_STEAM_GAMEPAD_VALUE=${SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD:-}
SDL_IGNORE_DEVICES_VALUE=${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}

{
    printf '\n[ullage-bridge] appid=%s arch=%s args=%s\n' "$APP_ID" "$ARCH" "$#"
    printf '[ullage-bridge] exe=%s\n' "$GAME_EXE"
    printf '[ullage-bridge] prefix=%s\n' "$PREFIX"
    printf '[ullage-bridge] wine=%s\n' "$WINE_BIN"
    printf '[ullage-bridge] host_lsteamclient=%s\n' "$HOST_LSTEAMCLIENT"
    printf '[ullage-bridge] win_lsteamclient=%s\n' "$WIN_LSTEAMCLIENT"
    printf '[ullage-bridge] preserve_steam_transport=%s\n' "$PRESERVE_STEAM_TRANSPORT"
    printf '[ullage-bridge] cloud_sync=%s\n' "${CLOUD_SYNC_COMMAND:+enabled}"
} >>"$LOG_FILE" 2>&1

run_cloud_sync() {
    phase=$1
    [ -n "$CLOUD_SYNC_COMMAND" ] || return 0
    ULLAGE_CLOUD_PHASE=$phase \
    ULLAGE_CLOUD_CDP=$CLOUD_CDP \
    ULLAGE_APPID=$APP_ID \
    ULLAGE_PREFIX=$PREFIX \
    ULLAGE_GAME_EXE=$GAME_EXE \
    ULLAGE_STEAM_ROOT=$STEAM_ROOT \
    ULLAGE_APPINFO=$STEAM_ROOT/appcache/appinfo.vdf \
    ULLAGE_STEAM3_ACCOUNT_ID=$CLOUD_STEAM3_ACCOUNT_ID \
    ULLAGE_STEAMID64=$CLOUD_STEAMID64 \
    ULLAGE_WINE_USER=$CLOUD_WINE_USER \
        /bin/sh -c "$CLOUD_SYNC_COMMAND" >>"$LOG_FILE" 2>&1
}

run_cloud_sync pre

cd "$GAME_DIR"
WINE_CHILD_PID=
SIGNAL_RECEIVED=0

forward_signal() {
    SIGNAL_RECEIVED=1
    if [ -n "${WINE_CHILD_PID:-}" ]; then
        kill -TERM "$WINE_CHILD_PID" 2>/dev/null || true
    fi
}

wait_and_reap() {
    wine_exit=0
    wait "$WINE_CHILD_PID" && wine_exit=0 || wine_exit=$?
    # A signal can interrupt wait(2) before Wine has observed the forwarded
    # TERM. Keep waiting while the exact child is still alive.
    while kill -0 "$WINE_CHILD_PID" 2>/dev/null; do
        wait "$WINE_CHILD_PID" && wine_exit=0 || wine_exit=$?
    done
    WINE_CHILD_PID=
    trap - HUP INT TERM

    "$REAPER" --prefix "$PREFIX" --wineserver "$WINESERVER" >>"$LOG_FILE" 2>&1 ||
        printf '[ullage-bridge] reaper failed for prefix=%s\n' "$PREFIX" >>"$LOG_FILE"
    run_cloud_sync post ||
        printf '[ullage-bridge] cloud post-sync failed for appid=%s\n' "$APP_ID" >>"$LOG_FILE"
    return "$wine_exit"
}

launch_clean() {
    "$FD_EXEC" /usr/bin/env -i \
        HOME="$HOME_VALUE" \
        USER="$USER_VALUE" \
        LOGNAME="$LOGNAME_VALUE" \
        PATH="$PATH_VALUE" \
        TMPDIR="${TMPDIR:-/tmp}" \
        LANG="$LANG_VALUE" \
        WINEPREFIX="$PREFIX" \
        WINESERVER="$WINESERVER" \
        WINEDLLPATH="$WINEDLLPATH_VALUE" \
        WINEDLLOVERRIDES="$WINEDLLOVERRIDES_VALUE" \
        WINEMSYNC="$WINEMSYNC_VALUE" \
        WINEDEBUG="$WINE_DEBUG_VALUE" \
        DYLD_FALLBACK_LIBRARY_PATH="$DYLD_FALLBACK_LIBRARY_PATH_VALUE" \
        WINE_GPTK_LIBD3DSHARED_PATH="$GPTK_D3DSHARED" \
        WINEENGINE_GPTK_DXGI_SPOOF_ENABLED=1 \
        SteamAppId="$APP_ID" \
        SteamGameId="$APP_ID" \
        SteamClientLaunch=1 \
        SteamOverlayGameId="$APP_ID" \
        SteamPath="$STEAM_ROOT" \
        STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_COMPAT_CLIENT_INSTALL_PATH" \
        STEAM_COMPAT_DATA_PATH="$PREFIX" \
        "$WINE_BIN" "$GAME_EXE" "$@" >>"$LOG_FILE" 2>&1 &
    WINE_CHILD_PID=$!
    trap forward_signal HUP INT TERM
    wait_and_reap
}

launch_with_steam_transport() {
    "$FD_EXEC" --preserve-fds /usr/bin/env -i \
        HOME="$HOME_VALUE" \
        USER="$USER_VALUE" \
        LOGNAME="$LOGNAME_VALUE" \
        PATH="$PATH_VALUE" \
        TMPDIR="${TMPDIR:-/tmp}" \
        LANG="$LANG_VALUE" \
        WINEPREFIX="$PREFIX" \
        WINESERVER="$WINESERVER" \
        WINEDLLPATH="$WINEDLLPATH_VALUE" \
        WINEDLLOVERRIDES="$WINEDLLOVERRIDES_VALUE" \
        WINEMSYNC="$WINEMSYNC_VALUE" \
        WINEDEBUG="$WINE_DEBUG_VALUE" \
        DYLD_FALLBACK_LIBRARY_PATH="$DYLD_FALLBACK_LIBRARY_PATH_VALUE" \
        WINE_GPTK_LIBD3DSHARED_PATH="$GPTK_D3DSHARED" \
        WINEENGINE_GPTK_DXGI_SPOOF_ENABLED=1 \
        SteamAppId="$APP_ID" \
        SteamGameId="$APP_ID" \
        SteamClientLaunch=1 \
        SteamOverlayGameId="$APP_ID" \
        SteamPath="$STEAM_ROOT" \
        STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_COMPAT_CLIENT_INSTALL_PATH" \
        STEAM_COMPAT_DATA_PATH="$PREFIX" \
        STEAM_DYLD_INSERT_LIBRARIES="$STEAM_DYLD_INSERT_LIBRARIES_VALUE" \
        DYLD_INSERT_LIBRARIES="$STEAM_DYLD_INSERT_LIBRARIES_VALUE" \
        SteamEnv="$STEAM_ENV_VALUE" \
        SteamAppUser="$STEAM_APP_USER_VALUE" \
        SteamUser="$STEAM_USER_VALUE" \
        Steam3Master="$STEAM3_MASTER_VALUE" \
        SteamVirtualGamepadInfo="$STEAM_VIRTUAL_GAMEPAD_INFO_VALUE" \
        STEAM_CLIENT_CONFIG_FILE="$STEAM_CLIENT_CONFIG_FILE_VALUE" \
        STEAM_APP_BUNDLE_PATH="$STEAM_APP_BUNDLE_PATH_VALUE" \
        ENABLE_VK_LAYER_VALVE_steam_overlay_1="$ENABLE_VK_LAYER_STEAM_OVERLAY_VALUE" \
        SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD="$SDL_STEAM_GAMEPAD_VALUE" \
        SDL_GAMECONTROLLER_IGNORE_DEVICES="$SDL_IGNORE_DEVICES_VALUE" \
        "$WINE_BIN" "$GAME_EXE" "$@" >>"$LOG_FILE" 2>&1 &
    WINE_CHILD_PID=$!
    trap forward_signal HUP INT TERM
    wait_and_reap
}

launch_exit=0
if [ "$PRESERVE_STEAM_TRANSPORT" = 1 ]; then
    launch_with_steam_transport "$@" || launch_exit=$?
else
    launch_clean "$@" || launch_exit=$?
fi
exit "$launch_exit"

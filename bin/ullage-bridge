#!/bin/sh
# Launch a Windows Steam depot through a macOS Wine/Game Porting Toolkit
# runtime while keeping the native macOS Steam client as the Steam backend.
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)
HOME_VALUE=${HOME:-/tmp}
STATE_HOME=${ULLAGE_STATE_DIR:-$HOME_VALUE/.ullage}

die() {
    printf 'ullage-bridge: %s\n' "$*" >&2
    exit 2
}

usage() {
    cat >&2 <<'EOF'
Usage:
  ullage-bridge --config FILE [options] [-- game-arguments...]

Required options (normally supplied by FILE):
  --appid ID                 Steam AppID
  --game-exe PATH            genuine Windows executable, not the shim

Runtime options:
  --game-dir PATH             working directory (defaults to executable dir)
  --state-dir PATH            generated state root (default: ~/.ullage)
  --prefix PATH               Wine prefix
  --arch auto|win32|win64     PE architecture (default: auto)
  --steam-root PATH           native Steam library root
  --wine-root PATH             GameHub Wine installation root
  --wine-dllpath PATHS         optional colon-separated Wine DLL search path
  --wine-dll-overrides VALUE   optional WINEDLLOVERRIDES value
  --wine-prefix-base PATH      optional GameHub base prefix for a virtual prefix
  --wine-arch win32|win64      optional WINEARCH value for the selected prefix
  --gptk-root PATH            Game Porting Toolkit runtime root
  --bridge-root PATH          directory containing lsteamclient artifacts
  --sandboxfs-manifest PATH   optional GameHub SandboxFS layer manifest
  --sandboxfs-lib PATH        optional GameHub SandboxFS dylib to inject
  --steamclient64-forwarder PATH
                              optional canonical-name Steam client forwarder
  --fd-exec PATH              fd-cleaning exec helper
  --reaper PATH               prefix-scoped Wine helper reaper
  --log PATH                  append Wine output here
  --wine-debug VALUE          WINEDEBUG value (default: -all)
  --winemsync VALUE           WINEMSYNC value (default: 1)
  --legacy-steam              require staged 32-bit legacy Steam DLLs
  --preserve-steam-transport  retain Steam's launch dylibs and IPC descriptors (default)
  --clean-steam-transport     close inherited Steam descriptors and skip overlay injection
  --dry-run                   validate and print the resolved launch
  --help

The -- separator is required before arguments intended for the game.
EOF
}

CONFIG=
APP_ID=
GAME_EXE=
GAME_DIR=
PREFIX=
ARCH=auto
STEAM_ROOT="${STEAM_ROOT:-$HOME_VALUE/Library/Application Support/Steam}"
WINE_ROOT="${WINE_ROOT:-}"
WINE_DLLPATH_VALUE="${WINE_DLLPATH_VALUE:-${WINE_DLLPATH:-}}"
WINEPREFIX_BASE_VALUE="${WINEPREFIX_BASE_VALUE:-${WINEPREFIX_BASE:-}}"
WINE_ARCH_VALUE="${WINE_ARCH_VALUE:-${WINEARCH:-}}"
GPTK_ROOT="${GPTK_ROOT:-}"
BRIDGE_ROOT="${BRIDGE_ROOT:-$REPO_ROOT/runtime/lsteamclient}"
SANDBOXFS_LAYER_MANIFEST_VALUE="${SANDBOXFS_LAYER_MANIFEST_VALUE:-${SANDBOXFS_LAYER_MANIFEST:-}}"
SANDBOXFS_LIB_PATH_VALUE="${SANDBOXFS_LIB_PATH_VALUE:-${SANDBOXFS_LIB_PATH:-}}"
STEAMCLIENT64_FORWARDER="${STEAMCLIENT64_FORWARDER:-}"
FD_EXEC="${FD_EXEC:-$SCRIPT_DIR/ullage-fd-exec}"
REAPER="${REAPER:-$SCRIPT_DIR/ullage-reap}"
LOG_FILE=
LEGACY_STEAM=0
DRY_RUN=0
WINE_DEBUG_VALUE=${WINE_DEBUG_VALUE:--all}
WINEMSYNC_VALUE=${WINEMSYNC_VALUE:-1}
WINE_SESSION_WAIT=${WINE_SESSION_WAIT:-1}
STEAM_STOP_WATCH=${STEAM_STOP_WATCH:-1}
PRESERVE_STEAM_TRANSPORT=1

load_config() {
    config_path=$1
    [ -r "$config_path" ] || die "config is not readable: $config_path"
    # Config files are generated by ullage-install and contain only
    # shell assignments. They are intentionally user-owned generated state.
    # shellcheck disable=SC1090
    . "$config_path"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --config)
            [ "$#" -ge 2 ] || die "--config requires a path"
            CONFIG=$2
            load_config "$CONFIG"
            shift 2
            ;;
        --state-dir)
            [ "$#" -ge 2 ] || die "--state-dir requires a path"
            STATE_HOME=$2
            shift 2
            ;;
        --appid)
            [ "$#" -ge 2 ] || die "--appid requires a value"
            APP_ID=$2
            shift 2
            ;;
        --game-exe)
            [ "$#" -ge 2 ] || die "--game-exe requires a path"
            GAME_EXE=$2
            shift 2
            ;;
        --game-dir)
            [ "$#" -ge 2 ] || die "--game-dir requires a path"
            GAME_DIR=$2
            shift 2
            ;;
        --prefix)
            [ "$#" -ge 2 ] || die "--prefix requires a path"
            PREFIX=$2
            shift 2
            ;;
        --arch)
            [ "$#" -ge 2 ] || die "--arch requires a value"
            ARCH=$2
            shift 2
            ;;
        --steam-root)
            [ "$#" -ge 2 ] || die "--steam-root requires a path"
            STEAM_ROOT=$2
            shift 2
            ;;
        --wine-root)
            [ "$#" -ge 2 ] || die "--wine-root requires a path"
            WINE_ROOT=$2
            shift 2
            ;;
        --wine-dllpath)
            [ "$#" -ge 2 ] || die "--wine-dllpath requires a value"
            WINE_DLLPATH_VALUE=$2
            shift 2
            ;;
        --wine-dll-overrides)
            [ "$#" -ge 2 ] || die "--wine-dll-overrides requires a value"
            WINEDLLOVERRIDES_VALUE=$2
            shift 2
            ;;
        --wine-prefix-base)
            [ "$#" -ge 2 ] || die "--wine-prefix-base requires a path"
            WINEPREFIX_BASE_VALUE=$2
            shift 2
            ;;
        --wine-arch)
            [ "$#" -ge 2 ] || die "--wine-arch requires a value"
            WINE_ARCH_VALUE=$2
            shift 2
            ;;
        --gptk-root)
            [ "$#" -ge 2 ] || die "--gptk-root requires a path"
            GPTK_ROOT=$2
            shift 2
            ;;
        --bridge-root)
            [ "$#" -ge 2 ] || die "--bridge-root requires a path"
            BRIDGE_ROOT=$2
            shift 2
            ;;
        --sandboxfs-manifest)
            [ "$#" -ge 2 ] || die "--sandboxfs-manifest requires a path"
            SANDBOXFS_LAYER_MANIFEST_VALUE=$2
            shift 2
            ;;
        --sandboxfs-lib)
            [ "$#" -ge 2 ] || die "--sandboxfs-lib requires a path"
            SANDBOXFS_LIB_PATH_VALUE=$2
            shift 2
            ;;
        --steamclient64-forwarder)
            [ "$#" -ge 2 ] || die "--steamclient64-forwarder requires a path"
            STEAMCLIENT64_FORWARDER=$2
            shift 2
            ;;
        --fd-exec)
            [ "$#" -ge 2 ] || die "--fd-exec requires a path"
            FD_EXEC=$2
            shift 2
            ;;
        --reaper)
            [ "$#" -ge 2 ] || die "--reaper requires a path"
            REAPER=$2
            shift 2
            ;;
        --log)
            [ "$#" -ge 2 ] || die "--log requires a path"
            LOG_FILE=$2
            shift 2
            ;;
        --wine-debug)
            [ "$#" -ge 2 ] || die "--wine-debug requires a value"
            WINE_DEBUG_VALUE=$2
            shift 2
            ;;
        --winemsync)
            [ "$#" -ge 2 ] || die "--winemsync requires a value"
            WINEMSYNC_VALUE=$2
            shift 2
            ;;
        --legacy-steam)
            LEGACY_STEAM=1
            shift
            ;;
        --preserve-steam-transport)
            PRESERVE_STEAM_TRANSPORT=1
            shift
            ;;
        --clean-steam-transport)
            PRESERVE_STEAM_TRANSPORT=0
            shift
            ;;
        --no-legacy-steam)
            LEGACY_STEAM=0
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            die "unknown option: $1 (put game arguments after --)"
            ;;
    esac
done

[ -n "$APP_ID" ] || die "missing --appid"
[ -n "$GAME_EXE" ] || die "missing --game-exe"
[ -n "$WINE_ROOT" ] || die "set --wine-root or WINE_ROOT"
[ -n "$GPTK_ROOT" ] || die "set --gptk-root or GPTK_ROOT"
case "$APP_ID" in
    *[!0-9]*|'' ) die "AppID must be numeric: $APP_ID" ;;
esac

case "$GAME_EXE" in
    /*) ;;
    *) GAME_EXE=$(CDPATH= cd "$(dirname "$GAME_EXE")" && pwd)/$(basename "$GAME_EXE") ;;
esac
[ -f "$GAME_EXE" ] || die "game executable is not a regular file: $GAME_EXE"
[ ! -L "$GAME_EXE" ] || die "game executable must not be a symlink: $GAME_EXE"

if [ -z "$GAME_DIR" ]; then
    GAME_DIR=$(CDPATH= cd "$(dirname "$GAME_EXE")" && pwd)
else
    case "$GAME_DIR" in
        /*) ;;
        *) GAME_DIR=$(CDPATH= cd "$GAME_DIR" && pwd) ;;
    esac
fi
[ -d "$GAME_DIR" ] || die "game directory does not exist: $GAME_DIR"

if [ -z "$PREFIX" ]; then
    PREFIX="${WINEPREFIX:-$STATE_HOME/compatdata/$APP_ID/pfx}"
fi
if [ -z "$LOG_FILE" ]; then
    LOG_FILE="$STATE_HOME/logs/$APP_ID.log"
fi

FILE_CMD=${FILE_CMD:-/usr/bin/file}
[ -x "$FILE_CMD" ] || die "missing /usr/bin/file"
GAME_FILE_INFO=$($FILE_CMD -b "$GAME_EXE")
case "$ARCH" in
    auto)
        case "$GAME_FILE_INFO" in
            *'PE32+'*) ARCH=win64 ;;
            *'PE32 executable'*) ARCH=win32 ;;
            *) die "could not identify a Windows PE executable: $GAME_FILE_INFO" ;;
        esac
        ;;
    win32|win64) ;;
    *) die "invalid --arch: $ARCH" ;;
esac

case "$ARCH:$GAME_FILE_INFO" in
    win64:*'PE32+'*) ;;
    win32:*'PE32 executable'*) ;;
    *) die "--arch=$ARCH does not match: $GAME_FILE_INFO" ;;
esac

case "$PRESERVE_STEAM_TRANSPORT" in
    0|1) ;;
    *) die "invalid --preserve-steam-transport value: $PRESERVE_STEAM_TRANSPORT" ;;
esac
case "$WINE_ARCH_VALUE" in
    ''|win32|win64) ;;
    *) die "invalid --wine-arch value: $WINE_ARCH_VALUE" ;;
esac

WINE_BIN="$WINE_ROOT/bin/wine"
WINESERVER="$WINE_ROOT/bin/wineserver"
STEAM_CLIENT_DYLIB="$STEAM_ROOT/Steam.AppBundle/Steam/Contents/MacOS/steamclient.dylib"
GPTK_D3DSHARED="$GPTK_ROOT/external/libd3dshared.dylib"
HOST_LSTEAMCLIENT="$BRIDGE_ROOT/x86_64-unix/lsteamclient.so"
if [ -z "$STEAMCLIENT64_FORWARDER" ]; then
    STEAMCLIENT64_FORWARDER="$BRIDGE_ROOT/x86_64-windows/steamclient64.dll"
fi
if [ "$ARCH" = win64 ]; then
    WIN_LSTEAMCLIENT="$BRIDGE_ROOT/x86_64-windows/lsteamclient.dll"
else
    WIN_LSTEAMCLIENT="$BRIDGE_ROOT/i386-windows/lsteamclient.dll"
fi

require_file() {
    [ -f "$1" ] || die "required file is missing: $1"
}

require_exec() {
    [ -x "$1" ] || die "required executable is missing or not executable: $1"
}

require_exec "$FD_EXEC"
require_exec "$REAPER"
require_exec "$WINE_BIN"
require_exec "$WINESERVER"
require_file "$STEAM_CLIENT_DYLIB"
require_file "$GPTK_D3DSHARED"
require_file "$HOST_LSTEAMCLIENT"
require_file "$WIN_LSTEAMCLIENT"
require_file "$PREFIX/system.reg"

if [ -n "$WINEPREFIX_BASE_VALUE" ]; then
    [ -d "$WINEPREFIX_BASE_VALUE" ] ||
        die "Wine prefix base does not exist: $WINEPREFIX_BASE_VALUE"
    [ -f "$WINEPREFIX_BASE_VALUE/system.reg" ] ||
        die "Wine prefix base is not initialized: $WINEPREFIX_BASE_VALUE"
fi
if [ -n "$SANDBOXFS_LAYER_MANIFEST_VALUE" ] || [ -n "$SANDBOXFS_LIB_PATH_VALUE" ]; then
    [ -n "$SANDBOXFS_LAYER_MANIFEST_VALUE" ] && [ -n "$SANDBOXFS_LIB_PATH_VALUE" ] ||
        die "--sandboxfs-manifest and --sandboxfs-lib must be supplied together"
    require_file "$SANDBOXFS_LAYER_MANIFEST_VALUE"
    require_file "$SANDBOXFS_LIB_PATH_VALUE"
fi

STEAMCLIENT64_TARGET="$PREFIX/drive_c/Program Files (x86)/Steam/steamclient64.dll"
if [ "$ARCH" = win64 ] && [ -f "$STEAMCLIENT64_FORWARDER" ]; then
    [ -f "$STEAMCLIENT64_TARGET" ] ||
        die "64-bit Steam client forwarder is not staged: $STEAMCLIENT64_TARGET"
    [ ! -L "$STEAMCLIENT64_TARGET" ] ||
        die "64-bit Steam client target must not be a symlink: $STEAMCLIENT64_TARGET"
    cmp -s "$STEAMCLIENT64_FORWARDER" "$STEAMCLIENT64_TARGET" ||
        die "staged steamclient64.dll does not match: $STEAMCLIENT64_TARGET"
fi
if [ "$LEGACY_STEAM" = 1 ]; then
    LEGACY_STEAM_DIR="$PREFIX/drive_c/Program Files (x86)/Steam"
    for legacy_file in steam.dll steamclient.dll tier0_s.dll vstdlib_s.dll; do
        require_file "$LEGACY_STEAM_DIR/$legacy_file"
    done
fi

if [ "$DRY_RUN" = 1 ]; then
    printf 'appid=%s\n' "$APP_ID"
    printf 'arch=%s\n' "$ARCH"
    printf 'game_exe=%s\n' "$GAME_EXE"
    printf 'game_dir=%s\n' "$GAME_DIR"
    printf 'prefix=%s\n' "$PREFIX"
    printf 'wine=%s\n' "$WINE_BIN"
    printf 'gptk=%s\n' "$GPTK_ROOT"
    printf 'wine_prefix_base=%s\n' "$WINEPREFIX_BASE_VALUE"
    printf 'wine_arch=%s\n' "$WINE_ARCH_VALUE"
    printf 'sandboxfs_manifest=%s\n' "$SANDBOXFS_LAYER_MANIFEST_VALUE"
    printf 'sandboxfs_lib=%s\n' "$SANDBOXFS_LIB_PATH_VALUE"
    printf 'steam_client=%s\n' "$STEAM_CLIENT_DYLIB"
    printf 'host_lsteamclient=%s\n' "$HOST_LSTEAMCLIENT"
    printf 'win_lsteamclient=%s\n' "$WIN_LSTEAMCLIENT"
    printf 'steamclient64_forwarder=%s\n' "$STEAMCLIENT64_FORWARDER"
    printf 'reaper=%s\n' "$REAPER"
    printf 'wine_session_wait=%s\n' "$WINE_SESSION_WAIT"
    printf 'legacy_steam=%s\n' "$LEGACY_STEAM"
    printf 'preserve_steam_transport=%s\n' "$PRESERVE_STEAM_TRANSPORT"
    printf 'game_argument_count=%s\n' "$#"
    exit 0
fi

mkdir -p "$(dirname "$LOG_FILE")"
USER_VALUE=${USER:-$(id -un)}
LOGNAME_VALUE=${LOGNAME:-$USER_VALUE}
LANG_VALUE=${LANG:-en_US.UTF-8}
PATH_VALUE=/usr/bin:/bin:/usr/sbin:/sbin
# Keep the command-line spelling as the source of truth. The installer writes
# WINEDLLPATH_VALUE into generated config for compatibility with older state,
# so retain it only when no explicit --wine-dllpath was supplied.
if [ -z "$WINE_DLLPATH_VALUE" ] && [ -n "${WINEDLLPATH_VALUE:-}" ]; then
    WINE_DLLPATH_VALUE=$WINEDLLPATH_VALUE
fi
if [ -n "$WINE_DLLPATH_VALUE" ]; then
    WINEDLLPATH_VALUE=$WINE_DLLPATH_VALUE
elif [ "$ARCH" = win64 ]; then
    WINEDLLPATH_VALUE="$BRIDGE_ROOT/x86_64-windows:$BRIDGE_ROOT/x86_64-unix:$BRIDGE_ROOT:$GPTK_ROOT/wine:$WINE_ROOT/lib/wine"
else
    WINEDLLPATH_VALUE="$BRIDGE_ROOT/i386-windows:$BRIDGE_ROOT/x86_64-unix:$BRIDGE_ROOT:$GPTK_ROOT/wine:$WINE_ROOT/lib/wine"
fi
DYLD_FALLBACK_LIBRARY_PATH_VALUE=${DYLD_FALLBACK_LIBRARY_PATH_VALUE:-$BRIDGE_ROOT/x86_64-unix:$GPTK_ROOT/external:$WINE_ROOT/lib:$WINE_ROOT/lib/wine/x86_64-unix}
WINEDLLOVERRIDES_VALUE=${WINEDLLOVERRIDES_VALUE:-${WINEDLLOVERRIDES:-lsteamclient=b}}
STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT/Steam.AppBundle/Steam/Contents/MacOS"

# Native Steam uses these values to bootstrap its macOS loader/overlay and
# Steam IPC transport. They are captured before the clean environment is
# constructed and reintroduced by the default transport-preserving launch.
STEAM_DYLD_INSERT_LIBRARIES_VALUE=${STEAM_DYLD_INSERT_LIBRARIES:-}
STEAM_ENV_VALUE=${SteamEnv:-}
STEAM_APP_USER_VALUE=${SteamAppUser:-}
STEAM_USER_VALUE=${SteamUser:-}
STEAM3_MASTER_VALUE=${Steam3Master:-}
STEAM_VIRTUAL_GAMEPAD_INFO_VALUE=${SteamVirtualGamepadInfo:-}
if [ -z "$STEAM_VIRTUAL_GAMEPAD_INFO_VALUE" ]; then
    STEAM_VIRTUAL_GAMEPAD_INFO_VALUE=${SteamVirtualGamepadInfo_Proton:-}
fi
DYLD_INSERT_LIBRARIES_VALUE=
if [ "$PRESERVE_STEAM_TRANSPORT" = 1 ] && [ -n "$STEAM_DYLD_INSERT_LIBRARIES_VALUE" ]; then
    DYLD_INSERT_LIBRARIES_VALUE=$STEAM_DYLD_INSERT_LIBRARIES_VALUE
fi
if [ -n "$SANDBOXFS_LIB_PATH_VALUE" ]; then
    if [ -n "$DYLD_INSERT_LIBRARIES_VALUE" ]; then
        DYLD_INSERT_LIBRARIES_VALUE="$DYLD_INSERT_LIBRARIES_VALUE:$SANDBOXFS_LIB_PATH_VALUE"
    else
        DYLD_INSERT_LIBRARIES_VALUE=$SANDBOXFS_LIB_PATH_VALUE
    fi
fi
STEAM_CLIENT_CONFIG_FILE_VALUE=${STEAM_CLIENT_CONFIG_FILE:-}
STEAM_APP_BUNDLE_PATH_VALUE=${STEAM_APP_BUNDLE_PATH:-}
ENABLE_VK_LAYER_STEAM_OVERLAY_VALUE=${ENABLE_VK_LAYER_VALVE_steam_overlay_1:-}
SDL_STEAM_GAMEPAD_VALUE=${SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD:-}
SDL_IGNORE_DEVICES_VALUE=${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}
if [ -n "$STEAM_VIRTUAL_GAMEPAD_INFO_VALUE" ]; then
    STEAM_VIRTUAL_GAMEPAD_PRESENT=1
else
    STEAM_VIRTUAL_GAMEPAD_PRESENT=0
fi

{
    printf '\n[ullage-bridge] appid=%s arch=%s args=%s\n' "$APP_ID" "$ARCH" "$#"
    printf '[ullage-bridge] exe=%s\n' "$GAME_EXE"
    printf '[ullage-bridge] prefix=%s\n' "$PREFIX"
    printf '[ullage-bridge] wine=%s\n' "$WINE_BIN"
    printf '[ullage-bridge] host_lsteamclient=%s\n' "$HOST_LSTEAMCLIENT"
    printf '[ullage-bridge] win_lsteamclient=%s\n' "$WIN_LSTEAMCLIENT"
    printf '[ullage-bridge] steamclient64_forwarder=%s\n' "$STEAMCLIENT64_FORWARDER"
    printf '[ullage-bridge] preserve_steam_transport=%s\n' "$PRESERVE_STEAM_TRANSPORT"
    printf '[ullage-bridge] steam_stop_watch=%s\n' "$STEAM_STOP_WATCH"
    printf '[ullage-bridge] wine_dll_overrides=%s\n' "$WINEDLLOVERRIDES_VALUE"
    printf '[ullage-bridge] wine_prefix_base=%s\n' "$WINEPREFIX_BASE_VALUE"
    printf '[ullage-bridge] wine_arch=%s\n' "$WINE_ARCH_VALUE"
    printf '[ullage-bridge] sandboxfs_manifest=%s\n' "$SANDBOXFS_LAYER_MANIFEST_VALUE"
    printf '[ullage-bridge] sandboxfs_lib=%s\n' "$SANDBOXFS_LIB_PATH_VALUE"
    printf '[ullage-bridge] dyld_insert_libraries=%s\n' "$DYLD_INSERT_LIBRARIES_VALUE"
    printf '[ullage-bridge] steam_virtual_gamepad_metadata=%s\n' "$STEAM_VIRTUAL_GAMEPAD_PRESENT"
} >>"$LOG_FILE" 2>&1

cd "$GAME_DIR"
WINE_CHILD_PID=
WINE_SERVER_WAIT_PID=
STEAM_STOP_WATCH_PID=
SIGNAL_RECEIVED=0
WINE_GAME_ROOT=$(printf 'Z:%s' "$GAME_DIR" | /usr/bin/sed 's|/|\\|g')

stop_steam_stop_watch() {
    if [ -n "${STEAM_STOP_WATCH_PID:-}" ]; then
        kill -TERM "$STEAM_STOP_WATCH_PID" 2>/dev/null || true
        wait "$STEAM_STOP_WATCH_PID" 2>/dev/null || true
        STEAM_STOP_WATCH_PID=
    fi
}

start_steam_stop_watch() {
    [ "$STEAM_STOP_WATCH" = 1 ] || return 0

    watch_log=$1
    watch_bridge_pid=$2
    watch_offset=0
    if [ -f "$watch_log" ]; then
        watch_offset=$(wc -c <"$watch_log" | tr -d '[:space:]')
    fi

    (
        while kill -0 "$watch_bridge_pid" 2>/dev/null; do
            if [ -f "$watch_log" ]; then
                watch_size=$(wc -c <"$watch_log" | tr -d '[:space:]')
                case "$watch_size" in
                    ''|*[!0-9]*) watch_size=$watch_offset ;;
                esac
                if [ "$watch_size" -lt "$watch_offset" ]; then
                    watch_offset=0
                fi
                if [ "$watch_size" -gt "$watch_offset" ]; then
                    if tail -c "+$((watch_offset + 1))" "$watch_log" 2>/dev/null |
                        grep -F "AppID $APP_ID state changed :" |
                        grep -F 'Terminating' >/dev/null
                    then
                        printf '[ullage-bridge] native Steam requested stop for appid=%s\n' \
                            "$APP_ID" >>"$LOG_FILE"
                        kill -TERM "$watch_bridge_pid" 2>/dev/null || true
                        exit 0
                    fi
                    watch_offset=$watch_size
                fi
            fi
            sleep 0.1
        done
    ) &
    STEAM_STOP_WATCH_PID=$!
}

forward_signal() {
    SIGNAL_RECEIVED=1
    stop_steam_stop_watch
    if [ -n "${WINE_CHILD_PID:-}" ]; then
        kill -TERM "$WINE_CHILD_PID" 2>/dev/null || true
    fi
    if [ -n "${WINE_SERVER_WAIT_PID:-}" ]; then
        kill -TERM "$WINE_SERVER_WAIT_PID" 2>/dev/null || true
    fi
}

wait_and_reap() {
    wine_exit=0
    signal_kill_timer_pid=
    # Reap the exact Wine launcher before waiting for the prefix server. A
    # parallel `wineserver -w` can return before a slow game registers its
    # server; treating that as completion kills a game that is still starting
    # and reports a false success.
    while :; do
        wait "$WINE_CHILD_PID" && wine_exit=0 || wine_exit=$?
        # A signal can interrupt wait(2) before Wine has observed the forwarded
        # TERM. Give the exact launcher a short, independently bounded grace
        # period, then force and reap it if necessary. The prefix-scoped
        # reaper below handles that launcher and any reparented game child, so
        # never let native Steam remain Terminating here.
        if [ "$SIGNAL_RECEIVED" = 1 ]; then
            if ! kill -0 "$WINE_CHILD_PID" 2>/dev/null; then
                break
            fi
            if [ -z "$signal_kill_timer_pid" ]; then
                (
                    sleep 2
                    kill -KILL "$WINE_CHILD_PID" 2>/dev/null || true
                ) &
                signal_kill_timer_pid=$!
                continue
            fi
            if kill -0 "$signal_kill_timer_pid" 2>/dev/null; then
                continue
            fi
            if kill -0 "$WINE_CHILD_PID" 2>/dev/null; then
                kill -KILL "$WINE_CHILD_PID" 2>/dev/null || true
            fi
            if wait "$WINE_CHILD_PID"; then
                wine_exit=0
            else
                wine_exit=$?
            fi
            break
        fi
        kill -0 "$WINE_CHILD_PID" 2>/dev/null || break
    done
    if [ -n "$signal_kill_timer_pid" ]; then
        kill -TERM "$signal_kill_timer_pid" 2>/dev/null || true
        wait "$signal_kill_timer_pid" 2>/dev/null || true
    fi
    WINE_CHILD_PID=

    if [ "$WINE_SESSION_WAIT" = 1 ] && [ "$SIGNAL_RECEIVED" = 0 ]; then
        # Some Wine builds leave start.exe or helper processes alive after the
        # Windows process exits. This drains that prefix-scoped session without
        # ever deciding that the game child is disposable.
        WINEPREFIX="$PREFIX" "$WINESERVER" -w >>"$LOG_FILE" 2>&1 &
        WINE_SERVER_WAIT_PID=$!
        # TERM can arrive during the child wait, before the drain process
        # exists. Do not turn that race into an unbounded post-signal wait.
        if [ "$SIGNAL_RECEIVED" = 1 ]; then
            kill -TERM "$WINE_SERVER_WAIT_PID" 2>/dev/null || true
        fi
        wait "$WINE_SERVER_WAIT_PID" 2>/dev/null || true
        WINE_SERVER_WAIT_PID=

        # A Windows launcher can exit after spawning another game process.
        # wineserver -w is not reliable for every such launcher, so keep the
        # bridge alive while a process from this depot is still present. This
        # also keeps the Steam Terminating watcher alive long enough to stop
        # the orphaned child through the scoped reaper.
        while :; do
            [ "$SIGNAL_RECEIVED" = 0 ] || break
            game_pids=$(
                /bin/ps -axo pid=,command= -ww 2>/dev/null |
                    /usr/bin/awk -v root="$WINE_GAME_ROOT" \
                        'index($0, root) {print $1}'
            )
            [ -z "$game_pids" ] || sleep 0.1
            [ -n "$game_pids" ] || break
        done
    fi

    stop_steam_stop_watch
    trap - HUP INT TERM

    if [ "$SIGNAL_RECEIVED" = 1 ]; then
        "$REAPER" --prefix "$PREFIX" --wineserver "$WINESERVER" \
            --game-root "$GAME_DIR" --kill-game-processes >>"$LOG_FILE" 2>&1 ||
            printf '[ullage-bridge] reaper failed for prefix=%s\n' "$PREFIX" >>"$LOG_FILE"
    else
        "$REAPER" --prefix "$PREFIX" --wineserver "$WINESERVER" >>"$LOG_FILE" 2>&1 ||
            printf '[ullage-bridge] reaper failed for prefix=%s\n' "$PREFIX" >>"$LOG_FILE"
    fi
    printf '[ullage-bridge] wine_exit=%s signal_received=%s\n' \
        "$wine_exit" "$SIGNAL_RECEIVED" >>"$LOG_FILE"
    return "$wine_exit"
}

launch_clean() {
    "$FD_EXEC" /usr/bin/env -i \
        HOME="$HOME_VALUE" \
        USER="$USER_VALUE" \
        LOGNAME="$LOGNAME_VALUE" \
        PATH="$PATH_VALUE" \
        TMPDIR="${TMPDIR:-/tmp}" \
        LANG="$LANG_VALUE" \
        WINEPREFIX="$PREFIX" \
        WINESERVER="$WINESERVER" \
        WINEDLLPATH="$WINEDLLPATH_VALUE" \
        WINEDLLOVERRIDES="$WINEDLLOVERRIDES_VALUE" \
        WINEMSYNC="$WINEMSYNC_VALUE" \
        WINEDEBUG="$WINE_DEBUG_VALUE" \
        DYLD_FALLBACK_LIBRARY_PATH="$DYLD_FALLBACK_LIBRARY_PATH_VALUE" \
        WINE_GPTK_LIBD3DSHARED_PATH="$GPTK_D3DSHARED" \
        WINE_PATH="$WINE_ROOT" \
        WINE_INSTALLATION_PATH="$WINE_ROOT" \
        SANDBOXFS_LAYER_MANIFEST="$SANDBOXFS_LAYER_MANIFEST_VALUE" \
        SANDBOXFS_LIB_PATH="$SANDBOXFS_LIB_PATH_VALUE" \
        WINEENGINE_GPTK_DXGI_SPOOF_ENABLED=1 \
        SteamAppId="$APP_ID" \
        SteamGameId="$APP_ID" \
        SteamClientLaunch=1 \
        SteamOverlayGameId="$APP_ID" \
        SteamPath="$STEAM_ROOT" \
        STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_COMPAT_CLIENT_INSTALL_PATH" \
        STEAM_COMPAT_DATA_PATH="$PREFIX" \
        /bin/sh -c '
            prefix_base=$1
            wine_arch=$2
            insert_libraries=$3
            shift 3
            if [ -n "$prefix_base" ]; then export WINEPREFIX_BASE="$prefix_base"; else unset WINEPREFIX_BASE; fi
            if [ -n "$wine_arch" ]; then export WINEARCH="$wine_arch"; else unset WINEARCH; fi
            if [ -n "$insert_libraries" ]; then export DYLD_INSERT_LIBRARIES="$insert_libraries"; else unset DYLD_INSERT_LIBRARIES; fi
            exec "$@"
        ' ullage-bridge-wine "$WINEPREFIX_BASE_VALUE" "$WINE_ARCH_VALUE" \
            "$DYLD_INSERT_LIBRARIES_VALUE" "$WINE_BIN" "$GAME_EXE" "$@" \
            >>"$LOG_FILE" 2>&1 &
    WINE_CHILD_PID=$!
    trap forward_signal HUP INT TERM
    start_steam_stop_watch "$STEAM_ROOT/logs/content_log.txt" "$$"
    wait_and_reap
}

launch_with_steam_transport() {
    "$FD_EXEC" --preserve-fds /usr/bin/env -i \
        HOME="$HOME_VALUE" \
        USER="$USER_VALUE" \
        LOGNAME="$LOGNAME_VALUE" \
        PATH="$PATH_VALUE" \
        TMPDIR="${TMPDIR:-/tmp}" \
        LANG="$LANG_VALUE" \
        WINEPREFIX="$PREFIX" \
        WINESERVER="$WINESERVER" \
        WINEDLLPATH="$WINEDLLPATH_VALUE" \
        WINEDLLOVERRIDES="$WINEDLLOVERRIDES_VALUE" \
        WINEMSYNC="$WINEMSYNC_VALUE" \
        WINEDEBUG="$WINE_DEBUG_VALUE" \
        DYLD_FALLBACK_LIBRARY_PATH="$DYLD_FALLBACK_LIBRARY_PATH_VALUE" \
        WINE_GPTK_LIBD3DSHARED_PATH="$GPTK_D3DSHARED" \
        WINE_PATH="$WINE_ROOT" \
        WINE_INSTALLATION_PATH="$WINE_ROOT" \
        SANDBOXFS_LAYER_MANIFEST="$SANDBOXFS_LAYER_MANIFEST_VALUE" \
        SANDBOXFS_LIB_PATH="$SANDBOXFS_LIB_PATH_VALUE" \
        WINEENGINE_GPTK_DXGI_SPOOF_ENABLED=1 \
        SteamAppId="$APP_ID" \
        SteamGameId="$APP_ID" \
        SteamClientLaunch=1 \
        SteamOverlayGameId="$APP_ID" \
        SteamPath="$STEAM_ROOT" \
        STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_COMPAT_CLIENT_INSTALL_PATH" \
        STEAM_COMPAT_DATA_PATH="$PREFIX" \
        STEAM_DYLD_INSERT_LIBRARIES="$STEAM_DYLD_INSERT_LIBRARIES_VALUE" \
        DYLD_INSERT_LIBRARIES= \
        SteamEnv="$STEAM_ENV_VALUE" \
        SteamAppUser="$STEAM_APP_USER_VALUE" \
        SteamUser="$STEAM_USER_VALUE" \
        Steam3Master="$STEAM3_MASTER_VALUE" \
        SteamVirtualGamepadInfo="$STEAM_VIRTUAL_GAMEPAD_INFO_VALUE" \
        STEAM_CLIENT_CONFIG_FILE="$STEAM_CLIENT_CONFIG_FILE_VALUE" \
        STEAM_APP_BUNDLE_PATH="$STEAM_APP_BUNDLE_PATH_VALUE" \
        ENABLE_VK_LAYER_VALVE_steam_overlay_1="$ENABLE_VK_LAYER_STEAM_OVERLAY_VALUE" \
        SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD="$SDL_STEAM_GAMEPAD_VALUE" \
        SDL_GAMECONTROLLER_IGNORE_DEVICES="$SDL_IGNORE_DEVICES_VALUE" \
        /bin/sh -c '
            prefix_base=$1
            wine_arch=$2
            insert_libraries=$3
            shift 3
            if [ -n "$prefix_base" ]; then export WINEPREFIX_BASE="$prefix_base"; else unset WINEPREFIX_BASE; fi
            if [ -n "$wine_arch" ]; then export WINEARCH="$wine_arch"; else unset WINEARCH; fi
            if [ -n "$insert_libraries" ]; then export DYLD_INSERT_LIBRARIES="$insert_libraries"; else unset DYLD_INSERT_LIBRARIES; fi
            exec "$@"
        ' ullage-bridge-wine "$WINEPREFIX_BASE_VALUE" "$WINE_ARCH_VALUE" \
            "$DYLD_INSERT_LIBRARIES_VALUE" "$WINE_BIN" "$GAME_EXE" "$@" \
            >>"$LOG_FILE" 2>&1 &
    WINE_CHILD_PID=$!
    trap forward_signal HUP INT TERM
    start_steam_stop_watch "$STEAM_ROOT/logs/content_log.txt" "$$"
    wait_and_reap
}

launch_exit=0
if [ "$PRESERVE_STEAM_TRANSPORT" = 1 ]; then
    launch_with_steam_transport "$@" || launch_exit=$?
else
    launch_clean "$@" || launch_exit=$?
fi
exit "$launch_exit"

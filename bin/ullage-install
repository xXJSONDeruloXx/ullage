#!/bin/sh
# Map Steam's native Play action to an external Ullage Wine launcher.
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)
BRIDGE="$SCRIPT_DIR/ullage-bridge"
APPINFO_TOOL="$SCRIPT_DIR/ullage-appinfo.py"
PATH_TOOL="$SCRIPT_DIR/ullage-path.py"
CLOUD_NATIVE_TOOL="$SCRIPT_DIR/ullage-cloud-native.py"
HOME_VALUE=${HOME:-/tmp}
STATE_HOME=${ULLAGE_STATE_DIR:-$HOME_VALUE/.ullage}

die() {
    printf 'ullage-install: %s\n' "$*" >&2
    exit 2
}

shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

usage() {
    cat >&2 <<'EOF'
Usage:
  ullage-install --appid ID --target PATH [options]

Options:
  --launch-entry KEY           redirect only this appinfo entry (default: all Windows .exe entries)
  --game-dir PATH             working directory (default: target directory)
  --install-dir PATH          Steam install root for the relative launch entry (default: game-dir)
  --state-dir PATH            generated state root (default: ~/.ullage)
  --prefix PATH               Wine prefix
  --arch auto|win32|win64     PE architecture (default: auto)
  --steam-root PATH           native Steam library root
  --wine-root PATH            Wine installation root
  --wine-dllpath PATHS        optional colon-separated Wine DLL search path
  --wine-dll-overrides VALUE  optional WINEDLLOVERRIDES value
  --gptk-root PATH            Game Porting Toolkit runtime root
  --bridge-root PATH          lsteamclient artifact root
  --steamclient64-forwarder PATH
                              optional canonical-name Steam client forwarder
  --log PATH                  append Wine output here
  --wine-debug VALUE          WINEDEBUG value (default: -all)
  --winemsync VALUE           WINEMSYNC value (default: 1)
  --legacy-steam              require staged 32-bit Steam DLLs
  --preserve-steam-transport  retain Steam's launch dylibs and IPC descriptors (default)
  --clean-steam-transport     close inherited Steam descriptors and skip overlay injection
  --cloud-wine-user NAME|auto  Wine user directory for native Cloud (default: auto)
  --cloud-steam3-account-id ID Steam3 account ID for local native Cloud seed
  --cloud-native               map Windows UFS roots into native Steam Cloud
  --cloud-native-platform NAME platform in the local override (default: Windows)
  --cloud-native-base PATH     MacAppSupport base (default: ~/Library/Application Support)
  --cloud-native-addpath-root NAME  relative root under MacAppSupport (default: Ullage)
  --cloud-steam-account-name NAME   Steam login name for SteamCloudDocuments (auto)
  --force                     replace an existing external mapping
  --help

Steam must be fully quit while this command edits appcache/appinfo.vdf. The
genuine Windows executable is never moved or overwritten.
EOF
}

APP_ID=
TARGET=
LAUNCH_ENTRY=
GAME_DIR=
GAME_DIR_EXPLICIT=0
INSTALL_DIR=
PREFIX=
ARCH=auto
STEAM_ROOT="${STEAM_ROOT:-$HOME_VALUE/Library/Application Support/Steam}"
WINE_ROOT="${WINE_ROOT:-}"
WINE_DLLPATH_VALUE="${WINE_DLLPATH:-}"
WINE_DLL_OVERRIDES_VALUE="${WINEDLLOVERRIDES_VALUE:-${WINEDLLOVERRIDES:-lsteamclient=b}}"
GPTK_ROOT="${GPTK_ROOT:-}"
BRIDGE_ROOT="${BRIDGE_ROOT:-$REPO_ROOT/runtime/lsteamclient}"
STEAMCLIENT64_FORWARDER="${STEAMCLIENT64_FORWARDER:-}"
LOG_FILE=
WINE_DEBUG_VALUE=${WINEDEBUG:--all}
WINEMSYNC_VALUE=${WINEMSYNC:-1}
LEGACY_STEAM=0
PRESERVE_STEAM_TRANSPORT=1
CLOUD_WINE_USER=${CLOUD_WINE_USER:-auto}
CLOUD_NATIVE=0
CLOUD_NATIVE_PLATFORM=${CLOUD_NATIVE_PLATFORM:-Windows}
CLOUD_NATIVE_BASE=${CLOUD_NATIVE_BASE:-$HOME_VALUE/Library/Application Support}
CLOUD_NATIVE_ADDPATH_ROOT=${CLOUD_NATIVE_ADDPATH_ROOT:-Ullage}
CLOUD_STEAM3_ACCOUNT_ID=${CLOUD_STEAM3_ACCOUNT_ID:-}
CLOUD_STEAM_ACCOUNT_NAME=${CLOUD_STEAM_ACCOUNT_NAME:-auto}
FORCE=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --appid) [ "$#" -ge 2 ] || die "--appid requires a value"; APP_ID=$2; shift 2 ;;
        --target) [ "$#" -ge 2 ] || die "--target requires a path"; TARGET=$2; shift 2 ;;
        --launch-entry) [ "$#" -ge 2 ] || die "--launch-entry requires a key"; LAUNCH_ENTRY=$2; shift 2 ;;
        --game-dir) [ "$#" -ge 2 ] || die "--game-dir requires a path"; GAME_DIR=$2; GAME_DIR_EXPLICIT=1; shift 2 ;;
        --install-dir) [ "$#" -ge 2 ] || die "--install-dir requires a path"; INSTALL_DIR=$2; shift 2 ;;
        --state-dir) [ "$#" -ge 2 ] || die "--state-dir requires a path"; STATE_HOME=$2; shift 2 ;;
        --prefix) [ "$#" -ge 2 ] || die "--prefix requires a path"; PREFIX=$2; shift 2 ;;
        --arch) [ "$#" -ge 2 ] || die "--arch requires a value"; ARCH=$2; shift 2 ;;
        --steam-root) [ "$#" -ge 2 ] || die "--steam-root requires a path"; STEAM_ROOT=$2; shift 2 ;;
        --wine-root) [ "$#" -ge 2 ] || die "--wine-root requires a path"; WINE_ROOT=$2; shift 2 ;;
        --wine-dllpath) [ "$#" -ge 2 ] || die "--wine-dllpath requires a value"; WINE_DLLPATH_VALUE=$2; shift 2 ;;
        --wine-dll-overrides) [ "$#" -ge 2 ] || die "--wine-dll-overrides requires a value"; WINE_DLL_OVERRIDES_VALUE=$2; shift 2 ;;
        --gptk-root) [ "$#" -ge 2 ] || die "--gptk-root requires a path"; GPTK_ROOT=$2; shift 2 ;;
        --bridge-root) [ "$#" -ge 2 ] || die "--bridge-root requires a path"; BRIDGE_ROOT=$2; shift 2 ;;
        --steamclient64-forwarder) [ "$#" -ge 2 ] || die "--steamclient64-forwarder requires a path"; STEAMCLIENT64_FORWARDER=$2; shift 2 ;;
        --log) [ "$#" -ge 2 ] || die "--log requires a path"; LOG_FILE=$2; shift 2 ;;
        --wine-debug) [ "$#" -ge 2 ] || die "--wine-debug requires a value"; WINE_DEBUG_VALUE=$2; shift 2 ;;
        --winemsync) [ "$#" -ge 2 ] || die "--winemsync requires a value"; WINEMSYNC_VALUE=$2; shift 2 ;;
        --legacy-steam) LEGACY_STEAM=1; shift ;;
        --no-legacy-steam) LEGACY_STEAM=0; shift ;;
        --preserve-steam-transport) PRESERVE_STEAM_TRANSPORT=1; shift ;;
        --clean-steam-transport) PRESERVE_STEAM_TRANSPORT=0; shift ;;
        --cloud-wine-user) [ "$#" -ge 2 ] || die "--cloud-wine-user requires a value"; CLOUD_WINE_USER=$2; shift 2 ;;
        --cloud-steam3-account-id) [ "$#" -ge 2 ] || die "--cloud-steam3-account-id requires a value"; CLOUD_STEAM3_ACCOUNT_ID=$2; shift 2 ;;
        --cloud-native) CLOUD_NATIVE=1; shift ;;
        --cloud-native-platform) [ "$#" -ge 2 ] || die "--cloud-native-platform requires a value"; CLOUD_NATIVE_PLATFORM=$2; shift 2 ;;
        --cloud-native-base) [ "$#" -ge 2 ] || die "--cloud-native-base requires a path"; CLOUD_NATIVE_BASE=$2; shift 2 ;;
        --cloud-native-addpath-root) [ "$#" -ge 2 ] || die "--cloud-native-addpath-root requires a value"; CLOUD_NATIVE_ADDPATH_ROOT=$2; shift 2 ;;
        --cloud-steam-account-name) [ "$#" -ge 2 ] || die "--cloud-steam-account-name requires a value"; CLOUD_STEAM_ACCOUNT_NAME=$2; shift 2 ;;
        --force) FORCE=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
done

[ -n "$APP_ID" ] || die "missing --appid"
[ -n "$TARGET" ] || die "missing --target"
case "$APP_ID" in *[!0-9]*|'') die "AppID must be numeric: $APP_ID" ;; esac
[ -z "$LAUNCH_ENTRY" ] || case "$LAUNCH_ENTRY" in *[!0-9]*|'') die "launch entry must be numeric: $LAUNCH_ENTRY" ;; esac
[ -x "$BRIDGE" ] || die "bridge is missing or not executable: $BRIDGE"
[ -x "$SCRIPT_DIR/ullage-fd-exec" ] || die "fd helper is missing or not executable: $SCRIPT_DIR/ullage-fd-exec"
[ -x "$APPINFO_TOOL" ] || die "appinfo editor is missing or not executable: $APPINFO_TOOL"
[ "$CLOUD_NATIVE" -ne 1 ] || [ -r "$CLOUD_NATIVE_TOOL" ] || die "native Cloud helper is missing: $CLOUD_NATIVE_TOOL"
[ -r "$PATH_TOOL" ] || die "path helper is missing: $PATH_TOOL"
PYTHON3_VALUE=${PYTHON3:-python3}
PYTHON3_BIN=$(command -v "$PYTHON3_VALUE" 2>/dev/null || true)
[ -n "$PYTHON3_BIN" ] || die "python3 is required (set PYTHON3 to override)"
[ -n "$WINE_ROOT" ] || die "set --wine-root or WINE_ROOT"
[ -n "$GPTK_ROOT" ] || die "set --gptk-root or GPTK_ROOT"

STEAM_PIDS=$(/usr/bin/pgrep -x steam_osx 2>/dev/null || true)
[ -z "$STEAM_PIDS" ] || die "quit native Steam before editing appcache (PIDs: $STEAM_PIDS)"

case "$TARGET" in
    /*) ;;
    *) TARGET=$(CDPATH= cd "$(dirname "$TARGET")" && pwd)/$(basename "$TARGET") ;;
esac
[ -f "$TARGET" ] || die "target is not a regular file: $TARGET"
[ ! -L "$TARGET" ] || die "target must not be a symlink: $TARGET"
case "$TARGET" in *.exe) ;; *) die "target does not look like an executable: $TARGET" ;; esac

if [ -z "$GAME_DIR" ]; then
    GAME_DIR=$(CDPATH= cd "$(dirname "$TARGET")" && pwd)
else
    case "$GAME_DIR" in
        /*) ;;
        *) GAME_DIR=$(CDPATH= cd "$GAME_DIR" && pwd) ;;
    esac
fi
[ -d "$GAME_DIR" ] || die "game directory does not exist: $GAME_DIR"

if [ -z "$INSTALL_DIR" ]; then
    INSTALL_DIR=$GAME_DIR
else
    case "$INSTALL_DIR" in
        /*) ;;
        *) INSTALL_DIR=$(CDPATH= cd "$INSTALL_DIR" && pwd) ;;
    esac
fi
[ -d "$INSTALL_DIR" ] || die "install directory does not exist: $INSTALL_DIR"

FILE_INFO=$(/usr/bin/file -b "$TARGET")
case "$FILE_INFO" in
    *'PE32 executable'*|*'PE32+'*) ;;
    *) die "target is not a Windows PE executable: $FILE_INFO" ;;
esac
if [ "$ARCH" = auto ]; then
    case "$FILE_INFO" in
        *'PE32+'*) ARCH=win64 ;;
        *'PE32 executable'*) ARCH=win32 ;;
    esac
fi
case "$ARCH" in win32|win64) ;; *) die "invalid --arch: $ARCH" ;; esac
case "$PRESERVE_STEAM_TRANSPORT" in 0|1) ;; *) die "invalid transport mode" ;; esac

WINE_BIN="$WINE_ROOT/bin/wine"
WINESERVER="$WINE_ROOT/bin/wineserver"
STEAM_CLIENT_DYLIB="$STEAM_ROOT/Steam.AppBundle/Steam/Contents/MacOS/steamclient.dylib"
[ -x "$WINE_BIN" ] || die "Wine executable is missing or not executable: $WINE_BIN"
[ -x "$WINESERVER" ] || die "wineserver is missing or not executable: $WINESERVER"
[ -f "$GPTK_ROOT/external/libd3dshared.dylib" ] ||
    die "GPTK shared library is missing: $GPTK_ROOT/external/libd3dshared.dylib"
[ -f "$STEAM_CLIENT_DYLIB" ] || die "native Steam client is missing: $STEAM_CLIENT_DYLIB"
[ -f "$BRIDGE_ROOT/x86_64-unix/lsteamclient.so" ] ||
    die "host lsteamclient is missing under: $BRIDGE_ROOT"
if [ "$ARCH" = win64 ]; then
    [ -f "$BRIDGE_ROOT/x86_64-windows/lsteamclient.dll" ] ||
        die "64-bit Windows lsteamclient is missing under: $BRIDGE_ROOT"
else
    [ -f "$BRIDGE_ROOT/i386-windows/lsteamclient.dll" ] ||
        die "32-bit Windows lsteamclient is missing under: $BRIDGE_ROOT"
fi
if [ -z "$STEAMCLIENT64_FORWARDER" ]; then
    STEAMCLIENT64_FORWARDER="$BRIDGE_ROOT/x86_64-windows/steamclient64.dll"
fi

if [ -z "$PREFIX" ]; then
    PREFIX="${WINEPREFIX:-$STATE_HOME/compatdata/$APP_ID/pfx}"
fi
[ -d "$PREFIX" ] || die "Wine prefix does not exist: $PREFIX"
[ -f "$PREFIX/system.reg" ] || die "Wine prefix is not initialized: $PREFIX"
if [ "$LEGACY_STEAM" = 1 ]; then
    LEGACY_STEAM_DIR="$PREFIX/drive_c/Program Files (x86)/Steam"
    for legacy_file in steam.dll steamclient.dll tier0_s.dll vstdlib_s.dll; do
        [ -f "$LEGACY_STEAM_DIR/$legacy_file" ] ||
            die "legacy Steam DLL is missing: $LEGACY_STEAM_DIR/$legacy_file"
    done
fi
if [ "$ARCH" = win64 ] && [ -f "$STEAMCLIENT64_FORWARDER" ]; then
    STEAMCLIENT64_TARGET="$PREFIX/drive_c/Program Files (x86)/Steam/steamclient64.dll"
    [ -f "$STEAMCLIENT64_TARGET" ] ||
        die "64-bit Steam client forwarder is not staged: $STEAMCLIENT64_TARGET"
    [ ! -L "$STEAMCLIENT64_TARGET" ] ||
        die "64-bit Steam client target must not be a symlink: $STEAMCLIENT64_TARGET"
    cmp -s "$STEAMCLIENT64_FORWARDER" "$STEAMCLIENT64_TARGET" ||
        die "staged steamclient64.dll does not match: $STEAMCLIENT64_TARGET"
fi
if [ -z "$LOG_FILE" ]; then
    LOG_FILE="$STATE_HOME/logs/$APP_ID.log"
fi

APPINFO="$STEAM_ROOT/appcache/appinfo.vdf"
[ -f "$APPINFO" ] || die "Steam appinfo cache is missing: $APPINFO"
CONFIG_DIR="$STATE_HOME/config/games"
CONFIG_FILE="$CONFIG_DIR/$APP_ID.conf"
STATE_FILE="$CONFIG_DIR/$APP_ID.launch.json"
CLOUD_STATE_FILE="$CONFIG_DIR/$APP_ID.cloud.json"
LAUNCHER_DIR="$STATE_HOME/launchers"
LAUNCHER="$LAUNCHER_DIR/$APP_ID.sh"
TARGET_NAME=$(basename "$TARGET")

for existing_file in "$CONFIG_FILE" "$STATE_FILE" "$LAUNCHER"; do
    if [ -e "$existing_file" ] && [ "$FORCE" -ne 1 ]; then
        die "generated file exists (use --force): $existing_file"
    fi
done
if [ "$CLOUD_NATIVE" -eq 1 ] && [ -e "$CLOUD_STATE_FILE" ] && [ "$FORCE" -ne 1 ]; then
    die "native Cloud state exists (use ullage-remove first or --force): $CLOUD_STATE_FILE"
fi

umask 077
mkdir -p "$CONFIG_DIR" "$LAUNCHER_DIR" "$STATE_HOME/backups/appinfo"
STAMP=$(/bin/date +%Y%m%d-%H%M%S).$$
APPINFO_BACKUP="$STATE_HOME/backups/appinfo/$APP_ID-$STAMP.vdf"
APPINFO_TMP="$APPINFO.tmp.$$"
CONFIG_TMP="$CONFIG_FILE.tmp.$$"
LAUNCHER_TMP="$LAUNCHER.tmp.$$"
LAUNCHER_TMP_DIR="$LAUNCHER_DIR/.${APP_ID}.launchers.tmp.$$"
LAUNCHER_PLAN="$CONFIG_DIR/.${APP_ID}.launchers.plan.$$"
LAUNCHER_COMMIT_PLAN=
SPECS_TMP="$CONFIG_DIR/.${APP_ID}.windows-specs.$$"
STATE_TMP="$STATE_FILE.tmp.$$"
CLOUD_STATE_TMP="$CLOUD_STATE_FILE.tmp.$$"
CONFIG_BACKUP=
STATE_BACKUP=
CLOUD_STATE_BACKUP=
APPINFO_INSTALLED=0
CLOUD_NATIVE_APPLIED=0
CONFIG_INSTALLED=0
STATE_INSTALLED=0
CLOUD_STATE_INSTALLED=0
LAUNCHERS_COMMITTED=0
MULTI_LAUNCH=0

remove_file() {
    if [ -e "$1" ] || [ -L "$1" ]; then
        unlink "$1"
    fi
}

make_launcher() {
    launcher=$1
    temporary=$2
    game_exe=$3
    game_dir=$4
    arch=$5
    {
        printf '#!/bin/sh\n'
        printf '# ullage external launcher v1\n'
        printf 'set -eu\n'
        printf 'exec %s --config %s --game-exe %s --game-dir %s --arch %s -- "$@"\n' \
            "$(shell_quote "$BRIDGE")" "$(shell_quote "$CONFIG_FILE")" \
            "$(shell_quote "$game_exe")" "$(shell_quote "$game_dir")" "$arch"
    } >"$temporary"
    chmod 755 "$temporary"
    printf '%s\t%s\t\n' "$launcher" "$temporary" >>"$LAUNCHER_PLAN"
}

rollback() {
    code=$?
    trap - EXIT HUP INT TERM
    if [ "$CLOUD_NATIVE_APPLIED" -eq 1 ] && [ -f "$CLOUD_STATE_TMP" ]; then
        cloud_appinfo="$APPINFO_TMP"
        [ "$APPINFO_INSTALLED" -eq 1 ] && cloud_appinfo="$APPINFO"
        "$PYTHON3_BIN" "$CLOUD_NATIVE_TOOL" restore \
            --appid "$APP_ID" \
            --appinfo "$cloud_appinfo" --state "$CLOUD_STATE_TMP" >/dev/null 2>&1 || true
    fi
    remove_file "$CONFIG_TMP"
    remove_file "$LAUNCHER_TMP"
    remove_file "$STATE_TMP"
    remove_file "$CLOUD_STATE_TMP"
    remove_file "$APPINFO_TMP"
    restore_launchers() {
        plan=$1
        [ -f "$plan" ] || return 0
        while IFS="$(printf '\t')" read -r launcher temporary backup; do
            [ -n "$launcher" ] || continue
            remove_file "$temporary"
            if [ "$LAUNCHERS_COMMITTED" -eq 1 ]; then
                remove_file "$launcher"
            fi
            if [ -n "$backup" ] && [ ! -e "$launcher" ] && [ -e "$backup" ]; then
                mv "$backup" "$launcher"
            fi
        done <"$plan"
    }
    if [ -n "$LAUNCHER_COMMIT_PLAN" ] && [ -f "$LAUNCHER_COMMIT_PLAN" ]; then
        restore_launchers "$LAUNCHER_COMMIT_PLAN"
    else
        restore_launchers "$LAUNCHER_PLAN"
    fi
    remove_file "$SPECS_TMP"
    if [ -n "$LAUNCHER_COMMIT_PLAN" ]; then remove_file "$LAUNCHER_COMMIT_PLAN"; fi
    if [ -d "$LAUNCHER_TMP_DIR" ]; then
        find "$LAUNCHER_TMP_DIR" -type f -delete
        rmdir "$LAUNCHER_TMP_DIR" 2>/dev/null || true
    fi
    if [ "$APPINFO_INSTALLED" -eq 1 ] && [ -f "$APPINFO_BACKUP" ]; then
        cp -p "$APPINFO_BACKUP" "$APPINFO"
    fi
    if [ "$CONFIG_INSTALLED" -eq 1 ]; then remove_file "$CONFIG_FILE"; fi
    if [ "$STATE_INSTALLED" -eq 1 ]; then remove_file "$STATE_FILE"; fi
    if [ "$CLOUD_STATE_INSTALLED" -eq 1 ]; then remove_file "$CLOUD_STATE_FILE"; fi
    if [ -n "$CONFIG_BACKUP" ] && [ ! -e "$CONFIG_FILE" ]; then mv "$CONFIG_BACKUP" "$CONFIG_FILE"; fi
    if [ -n "$STATE_BACKUP" ] && [ ! -e "$STATE_FILE" ]; then mv "$STATE_BACKUP" "$STATE_FILE"; fi
    if [ -n "$CLOUD_STATE_BACKUP" ] && [ ! -e "$CLOUD_STATE_FILE" ]; then mv "$CLOUD_STATE_BACKUP" "$CLOUD_STATE_FILE"; fi
    exit "$code"
}
trap rollback EXIT HUP INT TERM

cp -p "$APPINFO" "$APPINFO_BACKUP"
chmod 600 "$APPINFO_BACKUP"
cp -p "$APPINFO" "$APPINFO_TMP"

if [ -f "$STATE_FILE" ]; then
    "$PYTHON3_BIN" "$APPINFO_TOOL" restore --appid "$APP_ID" \
        --appinfo "$APPINFO_TMP" --state "$STATE_FILE" ||
        die "existing launch mapping cannot be restored; remove it or use a matching appcache"
fi
if [ "$CLOUD_NATIVE" -eq 1 ] && [ -f "$CLOUD_STATE_FILE" ]; then
    "$PYTHON3_BIN" "$CLOUD_NATIVE_TOOL" restore \
        --appid "$APP_ID" \
        --appinfo "$APPINFO_TMP" --state "$CLOUD_STATE_FILE" ||
        die "existing native Cloud mapping cannot be restored; remove it or use a matching appcache"
fi

: >"$LAUNCHER_PLAN"
if [ -n "$LAUNCH_ENTRY" ]; then
    LAUNCH_REL=$("$PYTHON3_BIN" "$PATH_TOOL" relative "$INSTALL_DIR" "$LAUNCHER")
    make_launcher "$LAUNCHER" "$LAUNCHER_TMP" "$TARGET" "$GAME_DIR" "$ARCH"
elif [ -n "$TARGET_NAME" ]; then
    "$PYTHON3_BIN" "$APPINFO_TOOL" list-windows \
        --appinfo "$APPINFO_TMP" --appid "$APP_ID" \
        --install-dir "$INSTALL_DIR" >"$SPECS_TMP"
    ENTRY_COUNT=$(wc -l <"$SPECS_TMP" | tr -d '[:space:]')
    [ "$ENTRY_COUNT" -gt 0 ] || die "no Windows launch entries found for AppID $APP_ID"
    if [ "$ENTRY_COUNT" -eq 1 ]; then
        single_game_dir=$GAME_DIR
        if [ "$GAME_DIR_EXPLICIT" -eq 0 ]; then
            IFS="$(printf '\t')" read -r ignored executable workingdir <"$SPECS_TMP"
            if [ -n "$workingdir" ]; then
                single_game_dir="$INSTALL_DIR/$workingdir"
            fi
        fi
        [ -d "$single_game_dir" ] ||
            die "working directory for the launch entry does not exist: $single_game_dir"
        LAUNCH_REL=$("$PYTHON3_BIN" "$PATH_TOOL" relative "$INSTALL_DIR" "$LAUNCHER")
        make_launcher "$LAUNCHER" "$LAUNCHER_TMP" "$TARGET" "$single_game_dir" "$ARCH"
    else
        MULTI_LAUNCH=1
        mkdir -p "$LAUNCHER_TMP_DIR"
        while IFS="$(printf '\t')" read -r entry executable workingdir; do
            [ -n "$entry" ] || continue
            case "$executable" in
                /*) die "Windows launch entry $entry is absolute: $executable" ;;
            esac
            entry_target="$INSTALL_DIR/$executable"
            [ -f "$entry_target" ] ||
                die "Windows launch entry $entry is missing: $entry_target"
            [ ! -L "$entry_target" ] ||
                die "Windows launch entry $entry is a symlink: $entry_target"
            entry_info=$(/usr/bin/file -b "$entry_target")
            case "$entry_info" in
                *'PE32+'*) entry_arch=win64 ;;
                *'PE32 executable'*) entry_arch=win32 ;;
                *) die "Windows launch entry $entry is not a PE executable: $entry_target" ;;
            esac
            if [ "$GAME_DIR_EXPLICIT" -eq 1 ]; then
                entry_game_dir=$GAME_DIR
            elif [ -n "$workingdir" ]; then
                entry_game_dir="$INSTALL_DIR/$workingdir"
            else
                entry_game_dir=$(CDPATH= cd "$(dirname "$entry_target")" && pwd)
            fi
            [ -d "$entry_game_dir" ] ||
                die "working directory for launch entry $entry does not exist: $entry_game_dir"
            entry_launcher="$LAUNCHER_DIR/$APP_ID-entry-$entry.sh"
            entry_temporary="$LAUNCHER_TMP_DIR/$APP_ID-entry-$entry.sh"
            if [ -e "$entry_launcher" ] && [ "$FORCE" -ne 1 ]; then
                die "generated file exists (use --force): $entry_launcher"
            fi
            make_launcher "$entry_launcher" "$entry_temporary" \
                "$entry_target" "$entry_game_dir" "$entry_arch"
        done <"$SPECS_TMP"
        LAUNCH_REL_TEMPLATE=$("$PYTHON3_BIN" "$PATH_TOOL" relative \
            "$INSTALL_DIR" "$LAUNCHER_DIR/$APP_ID-entry-{entry}.sh")
    fi
fi

{
    printf 'APP_ID=%s\n' "$(shell_quote "$APP_ID")"
    printf 'LAUNCH_ENTRY=%s\n' "$(shell_quote "$LAUNCH_ENTRY")"
    printf 'STATE_HOME=%s\n' "$(shell_quote "$STATE_HOME")"
    printf 'GAME_EXE=%s\n' "$(shell_quote "$TARGET")"
    printf 'GAME_DIR=%s\n' "$(shell_quote "$GAME_DIR")"
    printf 'PREFIX=%s\n' "$(shell_quote "$PREFIX")"
    printf 'ARCH=%s\n' "$(shell_quote "$ARCH")"
    printf 'STEAM_ROOT=%s\n' "$(shell_quote "$STEAM_ROOT")"
    printf 'WINE_ROOT=%s\n' "$(shell_quote "$WINE_ROOT")"
    printf 'WINEDLLPATH_VALUE=%s\n' "$(shell_quote "$WINE_DLLPATH_VALUE")"
    printf 'WINEDLLOVERRIDES_VALUE=%s\n' "$(shell_quote "$WINE_DLL_OVERRIDES_VALUE")"
    printf 'GPTK_ROOT=%s\n' "$(shell_quote "$GPTK_ROOT")"
    printf 'BRIDGE_ROOT=%s\n' "$(shell_quote "$BRIDGE_ROOT")"
    printf 'STEAMCLIENT64_FORWARDER=%s\n' "$(shell_quote "$STEAMCLIENT64_FORWARDER")"
    printf 'FD_EXEC=%s\n' "$(shell_quote "$SCRIPT_DIR/ullage-fd-exec")"
    printf 'LOG_FILE=%s\n' "$(shell_quote "$LOG_FILE")"
    printf 'LEGACY_STEAM=%s\n' "$(shell_quote "$LEGACY_STEAM")"
    printf 'PRESERVE_STEAM_TRANSPORT=%s\n' "$(shell_quote "$PRESERVE_STEAM_TRANSPORT")"
    printf 'CLOUD_NATIVE=%s\n' "$(shell_quote "$CLOUD_NATIVE")"
    printf 'CLOUD_NATIVE_PLATFORM=%s\n' "$(shell_quote "$CLOUD_NATIVE_PLATFORM")"
    printf 'CLOUD_NATIVE_BASE=%s\n' "$(shell_quote "$CLOUD_NATIVE_BASE")"
    printf 'CLOUD_NATIVE_ADDPATH_ROOT=%s\n' "$(shell_quote "$CLOUD_NATIVE_ADDPATH_ROOT")"
    printf 'WINE_DEBUG_VALUE=%s\n' "$(shell_quote "$WINE_DEBUG_VALUE")"
    printf 'WINEMSYNC_VALUE=%s\n' "$(shell_quote "$WINEMSYNC_VALUE")"
    printf 'WINE_SESSION_WAIT=%s\n' "$(shell_quote "${WINE_SESSION_WAIT:-1}")"
} >"$CONFIG_TMP"

if [ "$MULTI_LAUNCH" -eq 1 ]; then
    "$PYTHON3_BIN" "$APPINFO_TOOL" patch-all \
        --appinfo "$APPINFO_TMP" \
        --appid "$APP_ID" \
        --install-dir "$INSTALL_DIR" \
        --replace-template "$LAUNCH_REL_TEMPLATE" \
        --launcher-template "$LAUNCHER_DIR/$APP_ID-entry-{entry}.sh" \
        --state-out "$STATE_TMP"
elif [ -n "$LAUNCH_ENTRY" ]; then
    "$PYTHON3_BIN" "$APPINFO_TOOL" patch \
        --appinfo "$APPINFO_TMP" \
        --appid "$APP_ID" \
        --entry "$LAUNCH_ENTRY" \
        --replace "$LAUNCH_REL" \
        --launcher "$LAUNCHER" \
        --state-out "$STATE_TMP"
else
    "$PYTHON3_BIN" "$APPINFO_TOOL" patch \
        --appinfo "$APPINFO_TMP" \
        --appid "$APP_ID" \
        --match "$TARGET_NAME" \
        --replace "$LAUNCH_REL" \
        --launcher "$LAUNCHER" \
        --state-out "$STATE_TMP"
fi
if [ "$CLOUD_NATIVE" -eq 1 ]; then
    "$PYTHON3_BIN" "$CLOUD_NATIVE_TOOL" install \
        --appinfo "$APPINFO_TMP" \
        --appid "$APP_ID" \
        --prefix "$PREFIX" \
        --user "$CLOUD_WINE_USER" \
        --native-base "$CLOUD_NATIVE_BASE" \
        --addpath-root "$CLOUD_NATIVE_ADDPATH_ROOT" \
        --platform "$CLOUD_NATIVE_PLATFORM" \
        --steam-root "$STEAM_ROOT" \
        --steam3-account-id "$CLOUD_STEAM3_ACCOUNT_ID" \
        --install-dir "$INSTALL_DIR" \
        --steam-account-name "$CLOUD_STEAM_ACCOUNT_NAME" \
        --state-out "$CLOUD_STATE_TMP"
    CLOUD_NATIVE_APPLIED=1
fi
mv "$APPINFO_TMP" "$APPINFO"
APPINFO_INSTALLED=1

if [ -e "$CONFIG_FILE" ]; then
    CONFIG_BACKUP="$CONFIG_FILE.backup.$STAMP"
    mv "$CONFIG_FILE" "$CONFIG_BACKUP"
fi
if [ -e "$STATE_FILE" ]; then
    STATE_BACKUP="$STATE_FILE.backup.$STAMP"
    mv "$STATE_FILE" "$STATE_BACKUP"
fi
if [ "$CLOUD_NATIVE" -eq 1 ] && [ -e "$CLOUD_STATE_FILE" ]; then
    CLOUD_STATE_BACKUP="$CLOUD_STATE_FILE.backup.$STAMP"
    mv "$CLOUD_STATE_FILE" "$CLOUD_STATE_BACKUP"
fi

LAUNCHER_COMMIT_PLAN="$LAUNCHER_PLAN.commit.$$"
while IFS="$(printf '\t')" read -r launcher temporary ignored; do
    [ -n "$launcher" ] || continue
    backup="$launcher.backup.$STAMP"
    if [ -e "$launcher" ] || [ -L "$launcher" ]; then
        printf '%s\t%s\t%s\n' "$launcher" "$temporary" "$backup" >>"$LAUNCHER_COMMIT_PLAN"
        mv "$launcher" "$backup"
    else
        backup=
        printf '%s\t%s\t\n' "$launcher" "$temporary" >>"$LAUNCHER_COMMIT_PLAN"
    fi
done <"$LAUNCHER_PLAN"
mv "$LAUNCHER_COMMIT_PLAN" "$LAUNCHER_PLAN"

mv "$CONFIG_TMP" "$CONFIG_FILE"
CONFIG_INSTALLED=1
LAUNCHERS_COMMITTED=1
while IFS="$(printf '\t')" read -r launcher temporary ignored; do
    [ -n "$launcher" ] || continue
    mv "$temporary" "$launcher"
done <"$LAUNCHER_PLAN"
rmdir "$LAUNCHER_TMP_DIR" 2>/dev/null || true
mv "$STATE_TMP" "$STATE_FILE"
STATE_INSTALLED=1
if [ "$CLOUD_NATIVE" -eq 1 ]; then
    mv "$CLOUD_STATE_TMP" "$CLOUD_STATE_FILE"
    CLOUD_STATE_INSTALLED=1
fi
remove_file "$SPECS_TMP"
remove_file "$LAUNCHER_PLAN"
trap - EXIT HUP INT TERM

printf 'installed AppID %s\n' "$APP_ID"
printf 'target=%s\n' "$TARGET"
if [ "$MULTI_LAUNCH" -eq 1 ]; then
    printf 'launchers=%s\n' "$ENTRY_COUNT"
else
    printf 'launcher=%s\n' "$LAUNCHER"
    printf 'steam_executable=%s\n' "$LAUNCH_REL"
fi
printf 'config=%s\n' "$CONFIG_FILE"
printf 'state=%s\n' "$STATE_FILE"
printf 'appinfo_backup=%s\n' "$APPINFO_BACKUP"
printf '%s\n' 'Restart native Steam before pressing Play.'
